#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define LEF 2
#define RIG 1

/ {
    behaviors {
        ht: hold_tap {
            label = "hold_tap";
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            global-quick-tap;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        
        default_layer {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T    &kp Y &kp U &kp I &kp O &kp P
                &kp A &ht LALT S &ht LGUI D &ht LCTRL F &kp G    &kp H &ht RCTRL J &ht RGUI K &ht RALT L &kp BSPC
                &kp Z &kp X &kp C &kp V &kp B    &kp N &kp M &kp COMMA &kp DOT &kp ENTER
                                   &lt LEF TAB &kp LSHIFT &kp SPACE &lt RIG TAB
            >;
        };

        right_layer {
            bindings = <
                &kp N1 &kp N2 &kp N3 &kp N4 &kp N5    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0
                &trans &kp CAPS &kp PSCR &kp INS &trans    &kp PG_UP &kp LEFT &kp UP &kp RIGHT &kp DEL
                &kp UNDO &kp C_CUT &kp C_COPY &kp C_PASTE &kp AGAIN    &kp PG_DN &kp HOME &kp DOWN &kp END &kp ESC
                                             &trans &trans    &trans &trans
            >;
        };
    };
};
